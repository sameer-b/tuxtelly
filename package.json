{
  "name": "tuxtelly",
  "version": "0.2.16",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @tuxtelly/launcher dev",
    "dev:extension": "pnpm --filter @tuxtelly/extension dev",
    "build": "pnpm --filter @tuxtelly/launcher build && pnpm --filter @tuxtelly/extension build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:firefox": "node tests/firefox/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:extension": "web-ext lint --source-dir apps/extension/.output/firefox-mv3",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm lint:extension",
    "package": "node scripts/package.mjs",
    "sign:extension": "node --env-file-if-exists=.env.local scripts/sign-extension.mjs",
    "test:youtube": "node tests/firefox/youtube.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.2",
    "prettier": "3.9.10",
    "web-ext": "10.8.0",
    "selenium-webdriver": "4.51.0",
    "geckodriver": "8.0.0",
    "jsdom": "30.1.3",
    "@testing-library/react": "16.3.3"
  }
}
